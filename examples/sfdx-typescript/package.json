{
  "name": "sf-typings-sfdx-typescript-example",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test type-tests/structure.test.mjs",
    "typecheck:official": "tsc --strict --noEmit --target ESNext --module ESNext --moduleResolution Bundler --types @salesforce/lightning-types type-tests/official-types.ts",
    "generate:offline": "go run ../.. -config type-tests/offline.config.json -out .build/offline",
    "typecheck:offline": "tsc -p type-tests/offline/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p type-tests/tsconfig.json",
    "build": "npm run typecheck && tsc -p tsconfig.json --noEmit false"
  },
  "devDependencies": {
    "@salesforce/lightning-types": "0.9.0",
    "lwc": "8.20.3",
    "typescript": "5.8.3"
  }
}
